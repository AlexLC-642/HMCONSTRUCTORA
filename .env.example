# Todos los valores de este archivo son de ejemplo para desarrollo local
# (Docker Compose en localhost). Reemplaza TODOS los valores en cualquier
# entorno accesible fuera de localhost - nunca reutilices estas credenciales
# en staging o producción.
DATABASE_URL="mysql://constructora:constructora_password@localhost:3307/constructora_hm"
SHADOW_DATABASE_URL="mysql://root:root_password@localhost:3307/prisma_migrate_shadow_db"
AUTH_SECRET="replace-with-at-least-32-random-characters"
APP_URL="http://localhost:3000"
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="constructora-hm-dev"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_FORCE_PATH_STYLE="true"

# Habilita /api/dev/reset-database en local (además requiere NODE_ENV=development
# y una sesión de superadministrador). Nunca definir esta variable fuera de tu
# máquina de desarrollo.
ALLOW_DEV_DB_RESET="true"
